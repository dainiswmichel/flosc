# Distribution exclusions for `git archive` (export-ignore).
# Files stay TRACKED in the repo; they are omitted from the built release zip.
#
# Build a clean plugin-only zip (uses built-in git, no wp-cli needed):
#   git archive --worktree-attributes --format=zip -o ../flosc-<MTS>.zip HEAD
# Once this .gitattributes is committed, --worktree-attributes is optional.

# VCS / editor / local state
.git              export-ignore
.github           export-ignore
.githooks         export-ignore
.gitignore        export-ignore
.gitattributes    export-ignore
.distignore       export-ignore
.claude           export-ignore
.vscode           export-ignore
.idea             export-ignore
.DS_Store         export-ignore

