# PHPStan for FLOSC.
#
# The includes: line is load-bearing. Without szepeviktor/phpstan-wordpress,
# PHPStan does not know a single WordPress function and reports thousands of
# "Function wp_* not found" errors. That number looks like analysis and is
# nothing but a missing config. If you see it, the extension did not load and
# the run means nothing.
#
# PHPStan has never been run against this plugin. Its first real output is
# unknown. Unknown is information, not a regression.
includes:
    - %currentWorkingDirectory%/../.composer/vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    excludePaths:
        analyse:
            - */tests/*
            - */vendor/*
            - */node_modules/*
    reportUnmatchedIgnoredErrors: false

    # ONE WORKER, ON PURPOSE.
    # With parallel workers PHPStan died as
    #   "Child process error: PHPStan process crashed because it reached
    #    configured PHP memory limit: 1G ... while running parallel worker"
    # and then said "Result is incomplete because of severe errors". A crash in
    # a worker names no file, so there is nothing to act on. Serial is slower
    # and its memory ceiling applies to a single process, which makes both the
    # limit and any crash attributable. Raise the ceiling with
    # FLOSC_PHPSTAN_MEMORY (procedure 7 defaults it to 4G).
    parallel:
        maximumNumberOfProcesses: 1
