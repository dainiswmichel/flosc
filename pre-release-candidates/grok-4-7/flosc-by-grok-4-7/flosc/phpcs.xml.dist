<?xml version="1.0"?>
<ruleset name="FLOSC WordPress">
    <description>WordPress Coding Standards + PHP 7.4 compatibility for FLOSC. Authoritative check: run vendor/bin/phpcs . from this directory.</description>

    <!-- Scan PHP everywhere we ship code. -->
    <file>.</file>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="extensions" value="php"/>

    <!-- Never scan dependency trees or archive-only foldfers. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/pre-release-candidates/*</exclude-pattern>
    <exclude-pattern>*/flosc_development_archives/*</exclude-pattern>

    <!-- Thresholds -->
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="flosc"/>
            </property>
        </properties>
    </rule>

    <!--
        Project sanitizers, declared so the sniff can credit them.

        This list is the only place the project tells PHPCS that a function of
        its own sanitizes. There are no phpcs:ignore comments for this sniff
        anywhere in the shipping code, so a reviewer checks five definitions
        here rather than hunting annotations, and renaming every annotation in
        the tree changes nothing this sniff reports.

        What each one actually does, including what it deliberately does not do:

        flosc_sanitize_personality_profile_text - returns '' unless the value is
        valid UTF-8, then strips C0 control characters. Keeps Markdown on
        purpose: the value is an AI prompt, and it is escaped at every output
        point. It does not cap length; the editor warns after saving instead.

        flosc_sanitize_personality_workshop - returns '' unless the value is
        valid UTF-8 and decodes to a non-empty associative array, and otherwise
        returns only wp_json_encode() of that decoded structure, so the stored
        value is always JSON this plugin built.

        flosc_sanitize_ivr_markdown - returns WP_Error for a non-string, a null
        byte, unconvertible encoding or a body over its byte cap; otherwise
        normalizes newlines, strips C0 controls except tab and newline, and
        removes PHP open tags. Callers must handle the WP_Error.

        flosc_sanitize_posted_text - the same treatment for one posted leaf,
        without the cap and returning '' rather than WP_Error. Keeps newlines,
        which is why it is used instead of sanitize_text_field() across the IVR
        body: that function collapses every newline to a space.

        flosc_sanitize_api_secret - establishes that the value is text, rejects
        invalid UTF-8, and trims. It deliberately does NOT alter the token
        itself: sanitize_text_field() strips %HH sequences and collapses
        whitespace, and a provider key must be stored byte for byte or it stops
        working. Refusal of an over-long key or one carrying control characters
        is flosc_provider_key_is_plausible(), which every sink calls and which
        produces the message the operator sees.
    -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <properties>
            <property name="customSanitizingFunctions" type="array">
                <element value="flosc_sanitize_personality_profile_text"/>
                <element value="flosc_sanitize_personality_workshop"/>
                <element value="flosc_sanitize_api_secret"/>
                <element value="flosc_sanitize_ivr_markdown"/>
                <element value="flosc_sanitize_posted_text"/>
            </property>
        </properties>
    </rule>

    <!-- Function/class prefixes -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="flosc"/>
                <element value="FLOSC"/>
            </property>
        </properties>
    </rule>

    <!-- PHP floor safety net. TARGET = the same 7.4 name in flosc.php/readme.txt. -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>

    <!-- Keep the build and evidence out of the scan -->
    <exclude-pattern>*/build/*</exclude-pattern>
</ruleset>
