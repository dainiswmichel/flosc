+
+        if (!$session_id) {
+            return new WP_Error('invalid_session', 'Invalid session id', ['status' => 400]);
+        }
+
+        $session = $this->session_manager->get_flosc_session($session_id, $user_id);
+        if (!$session) {
+            return new WP_Error('not_found', 'Session not found', ['status' => 404]);
+        }
+
+        $role = sanitize_text_field($request->get_param('role'));
+        $content = sanitize_textarea_field($request->get_param('content'));
+
+        if (!in_array($role, ['user', 'assistant'], true)) {
+            return new WP_Error('invalid_role', 'Invalid role', ['status' => 400]);
+        }
+        if ($content === '') {
+            return new WP_Error('invalid_content', 'Empty content', ['status' => 400]);
+        }
+
+        $this->session_manager->add_flosc_message($session_id, $role, $content, $user_id);
+
+        return new WP_REST_Response([
+            'success' => true,
+        ]);
