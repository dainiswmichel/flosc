# Application Settings
APP_NAME=FLOSC Funnel System
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
DOMAIN=localhost:8000
HTTPS_ENABLED=False

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Brevo (Email) Configuration
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=LeSAEp Course

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_SUCCESS_URL=https://yourdomain.com/success
STRIPE_CANCEL_URL=https://yourdomain.com/offer

# Twilio Configuration (Optional - WhatsApp)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ENABLED=False

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ENABLED=False

# Whisper Configuration
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_DEVICE=cpu  # cpu or cuda
WHISPER_COMPUTE_TYPE=int8  # int8, float16, float32

# File Storage
UPLOAD_DIR=./uploads
STATIC_DIR=./static
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_FREELINE=3  # 3 attempts before blocking
RATE_LIMIT_WINDOW_HOURS=24

# OTO (One Time Offer) Configuration
OTO_DURATION_HOURS=24
OTO_REMINDER_HOURS=12,23  # Send reminders at 12hr and 23hr

# CORS (allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
